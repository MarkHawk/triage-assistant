# Copy to .env and fill in what you use. .env is gitignored.

# What to do if a secret turns up in log lines: mask (mask it, flag it to the engineer, carry on)
# or refuse (stop and send nothing). A value from the lab's own .env always stops the run.
LOG_SECRETS=mask

# Where identity-lab lives. Read only: this tool never changes it.
LAB_DIR=../identity-lab

# claude | ollama | demo   (demo replays saved answers and needs nothing else)
BACKEND=demo

# Claude API
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 1 asks the API to re-run a request on a fallback model if the first declines it. 0 turns that off.
CLAUDE_REFUSAL_FALLBACK=1

# Ollama on another machine on the LAN, for example http://ollama-box.lan:11434
OLLAMA_HOST=
OLLAMA_MODEL=
# Context window sent with every request. Never left to the server's default,
# which can silently cut a long prompt. 8192 works for a ~14B model on a 16 GB GPU
# but leaves each runbook only about 2000 characters. 12288 gives about 3400 and
# 16384 about 5000 (the runbooks are up to 10000). Raise it only after checking VRAM.
OLLAMA_NUM_CTX=8192
# Room kept free for the answer. Prompt budget = num_ctx - this.
OLLAMA_RESERVE_OUTPUT_TOKENS=1500
# Seconds. The first request may include loading the model into VRAM.
OLLAMA_FIRST_TIMEOUT_S=600
OLLAMA_TIMEOUT_S=300
# How long Ollama keeps the model loaded after a request.
OLLAMA_KEEP_ALIVE=30m
